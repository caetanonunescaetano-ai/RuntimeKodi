<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.runtimezorintv"
       name="ZorinTV"
       version="1.0.1"
       provider-name="ZorinTV">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="default.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="pt_BR">ZorinTV - Canais de TV ao vivo</summary>
        <description lang="pt_BR">ZorinTV com canais de TV ao vivo: Ação, Comédia, Romance, Família, Cine Espanto, Crime, Record News e mais.</description>
        <platform>all</platform>
        <license>All Rights Reserved</license>
        <assets>
            <icon>runtime.png</icon>
            <fanart>fanart.jpg</fanart>
        </assets>
    </extension>
</addon>
