<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="repository.runtimekodi"
       name="RuntimeKodi Repository"
       version="1.0.0"
       provider-name="ZorinTV">
    <requires>
        <import addon="xbmc.addon" version="19.0.0"/>
    </requires>
    <extension point="xbmc.addon.repository" name="RuntimeKodi">
        <info compressed="false">https://zorintv.github.io/RuntimeKodi/addons.xml</info>
        <checksum>https://zorintv.github.io/RuntimeKodi/addons.xml.md5</checksum>
        <datadir zip="true">https://zorintv.github.io/RuntimeKodi/zips/</datadir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="pt_BR">Repositório RuntimeKodi</summary>
        <description lang="pt_BR">Repositório com ZorinTV e PlutoTV.</description>
        <platform>all</platform>
        <assets>
            <icon>repository.runtimekodi/icon.png</icon>
            <fanart>repository.runtimekodi/fanart.jpg</fanart>
        </assets>
    </extension>
</addon>
